{
  "appName": "My Focus Queue",
  "dashboardPath": "/absolute/path/to/dashboard.json",
  "workspacePath": "/absolute/path/to/workspace",
  "projects": [
    {
      "id": "main-project",
      "name": "Main Project",
      "taskPrefix": "MAI",
      "repositoryPath": "/absolute/path/to/repository",
      "remoteAliases": []
    },
    {
      "id": "other",
      "name": "Other",
      "taskPrefix": "OTH",
      "repositoryPath": "",
      "remoteAliases": []
    }
  ],
  "defaultPlacement": "upper-left",
  "refreshIntervalSeconds": 2,
  "agentUsageBarEnabled": true,
  "agentProviderFallbackOrder": ["codex", "claude"],
  "agentEscalationAutoLaunch": true,
  "agentsPerWindow": 4,
  "placementModel": "claude-sonnet-light",
  "placementConfidenceThreshold": 0.6,
  "agentModelChoices": [
    {"provider": "codex", "label": "Default"},
    {"provider": "codex", "label": "gpt-6-astra", "model": "gpt-6-astra"},
    {"provider": "codex", "label": "gpt-6-sol", "model": "gpt-6-sol"},
    {"provider": "codex", "label": "gpt-6-luna", "model": "gpt-6-luna"},
    {"provider": "codex", "label": "gpt-5.6-sol", "model": "gpt-5.6-sol"},
    {"provider": "codex", "label": "gpt-5.6-terra", "model": "gpt-5.6-terra"},
    {"provider": "codex", "label": "gpt-5.6-luna", "model": "gpt-5.6-luna"},
    {"provider": "codex", "label": "gpt-5.5-pro", "model": "gpt-5.5-pro"},
    {"provider": "codex", "label": "gpt-5.5", "model": "gpt-5.5"},
    {"provider": "codex", "label": "gpt-5.4", "model": "gpt-5.4"},
    {"provider": "codex", "label": "gpt-5.2", "model": "gpt-5.2"},
    {"provider": "claude", "label": "Default"},
    {"provider": "claude", "label": "opus-5.5", "model": "claude-opus-5-5"},
    {"provider": "claude", "label": "sonnet-5.5", "model": "claude-sonnet-5-5"},
    {"provider": "claude", "label": "opus-5", "model": "claude-opus-5"},
    {"provider": "claude", "label": "sonnet-5", "model": "claude-sonnet-5"},
    {"provider": "claude", "label": "haiku-4.5", "model": "claude-haiku-4-5"},
    {"provider": "claude", "label": "opus", "model": "opus"},
    {"provider": "claude", "label": "sonnet", "model": "sonnet"},
    {"provider": "claude", "label": "haiku", "model": "haiku"},
    {"provider": "kimi", "label": "Default"},
    {"provider": "kimi", "label": "K3", "model": "kimi-code/k3"},
    {"provider": "kimi", "label": "K3-256k", "model": "kimi-code/k3-256k"},
    {"provider": "kimi", "label": "K2.8 Preview", "model": "kimi-code/kimi-for-coding"},
    {"provider": "kimi", "label": "K2.7 Code Highspeed", "model": "kimi-code/kimi-for-coding-highspeed"}
  ],
  "dailyRoutines": [
    {
      "id": "daily-review",
      "title": "Review today's queue",
      "url": "https://example.com/tasks"
    }
  ],
  "wezTerm": {
    "executable": "/absolute/path/to/wezterm",
    "applicationName": "WezTerm"
  },
  "verifier": {
    "enabled": false,
    "executable": "/absolute/path/to/focus-queue-codex",
    "sessionName": "focus-queue-codex-verifier",
    "timeoutSeconds": 120,
    "maxTurns": 24
  },
  "dailyReport": {
    "scheduleHour": 8,
    "scheduleMinute": 0,
    "maximumTokens": 75000,
    "enabledPlatforms": ["discord", "telegram", "email", "github"]
  }
}
