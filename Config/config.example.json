{
  "appName": "My Focus Queue",
  "dashboardPath": "/absolute/path/to/dashboard.json",
  "workspacePath": "/absolute/path/to/workspace",
  "projects": [
    {
      "id": "main-project",
      "name": "Main Project",
      "taskPrefix": "MAI",
      "repositoryPath": "/absolute/path/to/repository",
      "remoteAliases": []
    },
    {
      "id": "other",
      "name": "Other",
      "taskPrefix": "OTH",
      "repositoryPath": "",
      "remoteAliases": []
    }
  ],
  "defaultPlacement": "upper-left",
  "refreshIntervalSeconds": 2,
  "agentUsageBarEnabled": true,
  "dailyRoutines": [
    {
      "id": "daily-review",
      "title": "Review today's queue",
      "url": "https://example.com/tasks"
    }
  ],
  "wezTerm": {
    "executable": "/absolute/path/to/wezterm",
    "applicationName": "WezTerm"
  },
  "verifier": {
    "enabled": false,
    "executable": "/absolute/path/to/focus-queue-codex",
    "sessionName": "focus-queue-codex-verifier",
    "timeoutSeconds": 120,
    "maxTurns": 24
  },
  "dailyReport": {
    "scheduleHour": 8,
    "scheduleMinute": 0,
    "maximumTokens": 75000,
    "enabledPlatforms": ["discord", "telegram", "email", "github"]
  }
}
