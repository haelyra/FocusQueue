# ECC tiered sandbox, Tier 1 image for Focus Queue connector setup tests.
#
# Builds on the ECC Tier 1 base snapshot (rootless Podman, uid/gid 1000 user
# `ecc`, clean /home/ecc). Build that base once from the ECC checkout:
#   podman build --file images/sandbox/Containerfile.ubuntu \
#     --tag localhost/ecc-sandbox:ubuntu-lts images/sandbox
# This layer only adds the stdlib Python 3 the connector scripts need. Package
# installation happens here, at build time; test runs stay network-off.
ARG BASE_IMAGE=localhost/ecc-sandbox:ubuntu-lts
FROM ${BASE_IMAGE}

USER 0:0
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*
USER 1000:1000

ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
CMD ["sleep", "infinity"]

LABEL org.opencontainers.image.title="ECC Focus Queue connector sandbox (Tier 1)"
